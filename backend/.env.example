# FieldShift backend — environment variables (copy to .env, never commit secrets).

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
# Default: the Compose `postgis` service. For a hosted PostGIS (Supabase/Neon),
# point HOST/PORT/NAME/USER/PASSWORD at it (plan §3, §8).
POSTGRES_DB=fieldshift
POSTGRES_USER=fieldshift
POSTGRES_PASSWORD=fieldshift
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Security ----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,pilot.fieldshift.example
DJANGO_DEBUG=1

# --- CORS / single origin ----------------------------------------------------
# The SPA origin. In dev the Vite proxy makes this same-origin; set the real
# origin for a split-host deployment.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- NASA data layer ---------------------------------------------------------
POWER_BASE_URL=https://power.larc.nasa.gov/api
POWER_TIMEOUT_SECONDS=10
POWER_RETRIES=3
POWER_CACHE_TTL_SECONDS=604800
HLS_VALID_COVERAGE_MIN=0.40

# --- Celery ------------------------------------------------------------------
# Eager by default so the demo never depends on a broker (plan §3).
CELERY_TASK_ALWAYS_EAGER=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- NASA Earthdata Login (HLS ingest, scripts/ingest_hls.py) ----------------
# Store the token in .netrc or here — NEVER in git (plan §0).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
